<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 连接局域网中电脑上的插件（只用 TLS，见下方说明） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 监听网络变化，换网络后立即重连（data/live/NetworkMonitor） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 扫描配对二维码（只在扫码页面申请）。没有相机的设备也能安装，改用手动输入 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <!-- 前台服务保持连接，需要审批、回答提问或任务完成时通知（ADR 0009、m2-android.md 3.6） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      明文流量一律禁止（ADR 0003、安全红线第 4 条）：
      usesCleartextTraffic=false 加上 network_security_config 双重保证，单元测试会检查这两处。
      allowBackup=false：凭据不进入系统备份。
    -->
    <application
        android:name=".DshRemoteApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.DSHRemote"
        android:usesCleartextTraffic="false">

        <!-- singleTop：点通知时复用已经打开的界面（onNewIntent），不再叠一个新的。
             adjustResize：键盘高度只通过 insets 交给 Compose（imePadding）。不写时系统可能选 adjustPan，
             把整个窗口往上推，再加上 imePadding，键盘高度就算了两次（输入框停在屏幕中间） -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          前台服务的类型只在这里定义（ADR 0009）。specialUse 没有时长限制；
          PROPERTY_SPECIAL_USE_FGS_SUBTYPE 说明用途。不对外开放。
        -->
        <service
            android:name=".service.LinkService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="保持与用户自己电脑上 DSH 的连接，以便在需要审批或回答提问时通知用户" />
        </service>
    </application>

</manifest>
