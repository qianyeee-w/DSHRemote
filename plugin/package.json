{
  "name": "dshremote",
  "version": "0.1.0",
  "description": "DSHRemote 电脑端插件：让 Android 手机通过局域网安全地操控 DeepSeek Harness。",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test \"test/unit/**/*.test.js\"",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run lint && npm run typecheck && npm test",
    "load-check": "node test/load/load-check.mjs",
    "contract": "node test/contract/contract.mjs",
    "capture-fixtures": "node test/contract/capture-fixtures.mjs",
    "e2e": "node test/e2e/e2e.mjs",
    "browser-check": "node test/browser/admin-page.mjs",
    "dev-server": "node scripts/dev-server.mjs",
    "dev-server-check": "node test/dev-server/dev-server-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "playwright-core": "^1.65.0",
    "typescript": "7.0.2"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness"
  ],
  "dependencies": {
    "ws": "8.22.1"
  }
}
