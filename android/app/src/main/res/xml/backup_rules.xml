<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 及以下的备份规则：同 data_extraction_rules.xml，凭据不进入任何备份 -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
